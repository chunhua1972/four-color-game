{
  "name": "four-colors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @four-colors/web dev",
    "build": "pnpm --filter @four-colors/web build && pnpm build:edge",
    "build:edge": "node scripts/build-edge.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs && node scripts/test-db-cloud.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:deployed": "node scripts/test-deployed.mjs",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.js .github",
    "simulate": "node scripts/simulate.ts",
    "benchmark": "node scripts/benchmark.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:db && pnpm build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "pnpm": "12.9.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
